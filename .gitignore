# Trae 临时分享包
.trae-html-share-packages/

# 本地工具目录（解密/渲染/CDN 等本地副本，不提交）
tools/

# Trae 本地工作产物（不提交）
.workbuddy/

# 本地开发记忆（不提交）
DEV-MEMORY.md

# 整个技能文件夹均不提交（含 SSH 凭据的服务器技能、本地研究用技能）
.agents/skills/

# 活动插件：node_modules 与打包 zip 忽略；frontend/dist 是预构建插件产物，需随仓库提交
core/plugins/*/frontend/node_modules/
core/plugins/*/dist/
!core/plugins/*/frontend/dist/
# 归档插件（core/plugins-archive/）同样规则：保留源码，忽略构建产物
core/plugins-archive/*/frontend/node_modules/
core/plugins-archive/*/dist/
!core/plugins-archive/*/frontend/dist/
core/test/fixtures/milk-tea-plugin.zip

# 本地运行/打包残留（素材插件逐版本备份目录、Windows 启动脚本）
core/plugins/.material-plugin.prev-*/
run-server.bat

# 素材插件工作目录：打包脚本从此读取素材，打包前不入库（plugins/material-plugin/ 是唯一样本来源）
core/src/gameConfig/seed_images_named/
core/src/gameConfig/plant_images/
core/src/gameConfig/effect_images/
core/src/gameConfig/EventPlants.json

# 活动插件 assets/ 素材（manifest.frontend.assetPrefix 声明的活动 UI 图，必须随插件入库）
# material-plugin 只合并种子图/阶段图/effect，不包含活动 UI 图
